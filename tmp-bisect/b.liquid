{%- liquid
  assign seo_root = request.origin | append: routes.root_url
  assign seo_org_id = request.origin | append: '/#organization'
  assign seo_store_id = request.origin | append: '/#store'
  assign seo_en = false
  if request.locale.iso_code == 'en'
    assign seo_en = true
  endif

  assign seo_same_as = ''
  assign seo_socials = 'social_facebook_link,social_instagram_link,social_tiktok_link,social_youtube_link,social_twitter_link,social_pinterest_link,social_tumblr_link,social_snapchat_link,social_vimeo_link' | split: ','
  for s in seo_socials
    if settings[s] != blank
      assign seo_same_as = seo_same_as | append: settings[s] | append: '|'
    endif
  endfor
  unless seo_same_as contains 'tiktok.com'
    assign seo_same_as = seo_same_as | append: 'https://www.tiktok.com/@tomassicoffee|'
  endunless
  assign seo_same_as = seo_same_as | split: '|'
-%}
{%- comment -%} Breadcrumb {%- endcomment -%}
{%- liquid
  assign seo_crumbs = ''
  assign seo_home = 'Home'
  case request.page_type
    when 'product'
      assign seo_col = collection
      if seo_col == blank
        assign seo_col = product.collections.first
      endif
      if seo_col != blank
        assign seo_crumbs = seo_col.title | append: '§' | append: request.origin | append: seo_col.url | append: '¶'
      endif
      assign seo_crumbs = seo_crumbs | append: product.title | append: '§' | append: request.origin | append: product.url
    when 'collection'
      assign seo_crumbs = collection.title | append: '§' | append: request.origin | append: collection.url
    when 'blog'
      assign seo_crumbs = blog.title | append: '§' | append: request.origin | append: blog.url
    when 'article'
      assign seo_crumbs = blog.title | append: '§' | append: request.origin | append: blog.url | append: '¶' | append: article.title | append: '§' | append: request.origin | append: article.url
    when 'page'
      assign seo_crumbs = page.title | append: '§' | append: request.origin | append: page.url
  endcase
-%}
{%- if seo_crumbs != blank -%}
  {%- assign seo_crumb_list = seo_crumbs | split: '¶' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ seo_home | json }},
          "item": {{ seo_root | json }}
        }
        {%- for c in seo_crumb_list -%}
          {%- assign c_parts = c | split: '§' -%}
          ,
          {
            "@type": "ListItem",
            "position": {{ forloop.index | plus: 1 }},
            "name": {{ c_parts[0] | json }},
            "item": {{ c_parts[1] | json }}
          }
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

