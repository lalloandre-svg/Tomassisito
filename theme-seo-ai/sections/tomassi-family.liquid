<script>
  (function () {
    var root = document.getElementById('Fam-{{ sid }}');
    if (!root) return;
    /* Apre il pannello dell'app fedelta se c'e; altrimenti il link porta a registrazione/login */
    root.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('[data-fam-open]');
      if (!a) return;
      var launcher = document.querySelector('#honeypop-app button');
      if (launcher) { e.preventDefault(); launcher.click(); }
    });
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !('IntersectionObserver' in window)) return;
    root.classList.add('fam-js');
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
    }, { rootMargin: '0px 0px -8% 0px', threshold: .12 });
    root.querySelectorAll('[data-fam-r]').forEach(function (el) { io.observe(el); });
  })();
</script>

