{%- comment -%}
  Tomassi — "La storia nella tazza": blocco editoriale 2 colonne (foto + racconto)
  per la pagina prodotto. Foto con parallax leggero, testo con reveal.
  Tutto gestibile dal customizer; immagine opzionale.
  Foto: quella scelta nel customizer, altrimenti la 2ª foto del prodotto (di solito
  campo/origine), altrimenti la principale, altrimenti gradiente caldo.
  Scheda origine: metafield prodotto custom.origine / custom.varieta / custom.processo.
{%- endcomment -%}

{%- liquid
  assign pst_image = section.settings.image
  assign pst_alt = section.settings.heading
  if pst_image == blank and product and section.settings.use_product_image
    assign pst_images = product.media | where: 'media_type', 'image'
    if pst_images.size > 1
      assign pst_image = pst_images[1].preview_image
    elsif pst_images.size == 1
      assign pst_image = pst_images[0].preview_image
    endif
    assign pst_alt = pst_image.alt | default: product.title
  endif

  assign pst_facts = false
  if product and section.settings.show_facts
    assign pst_mf = product.metafields.custom
    if pst_mf.origine != blank or pst_mf.varieta != blank or pst_mf.processo != blank
      assign pst_facts = true
    endif
  endif

  # Nel customizer niente animazione d'ingresso: la foto deve vedersi subito.
  assign pst_reveal = true
  if request.design_mode
    assign pst_reveal = false
  endif
-%}

{%- style -%}
  #ProductStory-{{ section.id }} {
    --pst-bg: {{ section.settings.bg_color }};
    --pst-fg: {{ section.settings.text_color }};
    --pst-accent: {{ section.settings.accent_color }};
    background: var(--pst-bg);
    color: var(--pst-fg);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #ProductStory-{{ section.id }} .pst-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
    align-items: center;
    max-width: 104rem;
    margin-inline: auto;
  }
  @media screen and (min-width: 750px) {
    #ProductStory-{{ section.id }} .pst-grid {
      grid-template-columns: 1.05fr 1fr;
      gap: clamp(2.8rem, 1.6rem + 4vw, 6rem);
    }
    {% if section.settings.image_position == 'right' %}
      #ProductStory-{{ section.id }} .pst-media { order: 2; }
    {% endif %}
  }
{%- endstyle -%}

<section id="ProductStory-{{ section.id }}" class="product-story">
  <div class="page-width">
    <div class="pst-grid">
      <div class="pst-media"{% if pst_reveal %} data-reveal="zoom"{% endif %}>
        <div class="pst-media__frame">
          {%- if pst_image != blank -%}
            <div class="pst-media__inner" data-parallax="0.08">
              {{
                pst_image
                | image_url: width: 1400
                | image_tag:
                  loading: 'lazy',
                  widths: '500, 750, 1000, 1400',
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  class: 'pst-img',
                  alt: pst_alt
              }}
            </div>
          {%- else -%}
            <div class="pst-media__inner pst-media__inner--ph"></div>
          {%- endif -%}
        </div>
      </div>

      <div class="pst-body"{% if pst_reveal %} data-reveal="right"{% endif %}>
        {%- if section.settings.kicker != blank -%}
          <span class="pst-kicker">{% render 'tomassi-i18n', s: section.settings.kicker %}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pst-title">
            {%- render 'tomassi-i18n', s: section.settings.heading -%}
            {%- if section.settings.heading_accent != blank -%}
              <span class="pst-title-accent"> {% render 'tomassi-i18n', s: section.settings.heading_accent %}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="pst-text">{% render 'tomassi-i18n', s: section.settings.text, esc: false %}</div>
        {%- endif -%}
        {%- if pst_facts -%}
          {%- assign pst_en = false -%}
          {%- if request.locale.iso_code == 'en' -%}{%- assign pst_en = true -%}{%- endif -%}
          <dl class="pst-facts">
            {%- if pst_mf.origine != blank -%}
              <div class="pst-fact">
                <dt>{% if pst_en %}Origin{% else %}Origine{% endif %}</dt>
                <dd>{{ pst_mf.origine.value | escape }}</dd>
              </div>
            {%- endif -%}
            {%- if pst_mf.varieta != blank -%}
              <div class="pst-fact">
                <dt>{% if pst_en %}Variety{% else %}Varietà{% endif %}</dt>
                <dd>{{ pst_mf.varieta.value | escape }}</dd>
              </div>
            {%- endif -%}
            {%- if pst_mf.processo != blank -%}
              <div class="pst-fact">
                <dt>{% if pst_en %}Process{% else %}Processo{% endif %}</dt>
                <dd>{{ pst_mf.processo.value | escape }}</dd>
              </div>
            {%- endif -%}
          </dl>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          {%- comment -%} Link vuoto → pagina La nostra Torrefazione (prima era '#', che riportava in cima alla pagina) {%- endcomment -%}
          {%- assign pst_fallback = routes.root_url | append: '/pages/la-nostra-torrefazione' | replace: '//', '/' -%}
          <a class="pst-link" href="{{ section.settings.button_link | default: pst_fallback }}">
            {% render 'tomassi-i18n', s: section.settings.button_label %}
            <span class="pst-arrow" aria-hidden="true">&rarr;</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- style -%}
  .pst-media__frame { border-radius: 20px; overflow: hidden; }
  .pst-media__inner {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: radial-gradient(120% 110% at 30% 20%, #7a5230, #5A3523 70%, #3d2418);
  }
  .pst-img { width: 100%; height: 112%; margin-top: -6%; object-fit: cover; display: block; }
  .pst-kicker {
    display: inline-block;
    margin-bottom: 1.1rem;
    font-size: 1.2rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--pst-accent);
  }
  .pst-title {
    margin: 0 0 1.4rem;
    font-family: var(--font-heading-family);
    font-weight: 800;
    font-size: clamp(2.4rem, 1.8rem + 2.2vw, 3.6rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
  }
  .pst-title-accent { color: var(--pst-accent); }
  .pst-text {
    font-size: clamp(1.5rem, 1.35rem + 0.3vw, 1.75rem);
    line-height: 1.6;
    opacity: 0.92;
    max-width: 58ch;
  }
  .pst-text p { margin: 0 0 1.2rem; }
  .pst-text p:last-child { margin-bottom: 0; }
  .pst-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1.2rem 2.4rem;
    margin: 2.4rem 0 0;
    padding-top: 1.8rem;
    border-top: 1px solid color-mix(in srgb, var(--pst-fg) 14%, transparent);
    max-width: 58ch;
  }
  .pst-fact { margin: 0; }
  .pst-fact dt {
    margin-bottom: 0.3rem;
    font-size: 1.1rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--pst-accent);
  }
  .pst-fact dd {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 1.6rem;
    line-height: 1.3;
  }
  .pst-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.8rem;
    font-weight: 700;
    font-size: 1.55rem;
    text-decoration: none;
    color: var(--pst-accent);
    color: color-mix(in srgb, var(--pst-accent) 82%, var(--pst-fg));
  }
  .pst-arrow { transition: transform 0.22s cubic-bezier(0.2, 1, 0.3, 1); }
  .pst-link:hover .pst-arrow { transform: translateX(5px); }
  @media (prefers-reduced-motion: reduce) {
    .pst-arrow { transition: none; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Storia prodotto",
  "tag": "section",
  "class": "section section--product-story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Foto", "info": "Lascia vuoto per usare la foto del prodotto" },
    { "type": "checkbox", "id": "use_product_image", "label": "Senza foto: usa la foto del prodotto", "default": true },
    { "type": "checkbox", "id": "show_facts", "label": "Mostra origine, varietà e processo (metafield del prodotto)", "default": true },
    {
      "type": "select", "id": "image_position", "label": "Posizione foto",
      "options": [
        { "value": "left", "label": "Sinistra" },
        { "value": "right", "label": "Destra" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "kicker", "label": "Sopratitolo", "default": "La storia nella tazza" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Coltivato da tante mani," },
    { "type": "text", "id": "heading_accent", "label": "Titolo — parte in ocra", "default": "tostato da una." },
    { "type": "richtext", "id": "text", "label": "Testo", "default": "<p>Selezione a mano, in altura. Noi lo tostiamo il martedì ad Aprilia, in piccoli lotti, con un profilo costruito al banco. Dalla pianta alla tua tazza, senza scorciatoie.</p>" },
    { "type": "text", "id": "button_label", "label": "Testo link" },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "header", "content": "Colori" },
    { "type": "color", "id": "bg_color", "label": "Sfondo", "default": "#F6EEDC" },
    { "type": "color", "id": "text_color", "label": "Testo", "default": "#1B1814" },
    { "type": "color", "id": "accent_color", "label": "Accento (ocra)", "default": "#C2922D" },
    { "type": "header", "content": "Spaziatura" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Spazio sopra", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Spazio sotto", "default": 72 }
  ],
  "presets": [
    { "name": "Storia prodotto" }
  ]
}
{% endschema %}
