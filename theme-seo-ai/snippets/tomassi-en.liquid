{%- assign t_out = html -%}
{%- if pairs != '' -%}
  {%- assign t_list = pairs | split: '§' -%}
  {%- for t_pair in t_list -%}
    {%- assign t_kv = t_pair | strip | split: '¦' -%}
    {%- if t_kv.size == 2 -%}
      {%- assign t_out = t_out | replace: t_kv[0], t_kv[1] -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{{- t_out -}}
