{%- comment -%}
  Tomassi — Countdown tostatura come BANDA UNICA nell'header. Bilingue IT/EN.
  Unica fascia informativa del sito: conto alla rovescia + spedizione gratuita.
  Orario unico della tostatura: martedì alle 12:00, ora di Roma.
  Lo stesso orario è usato dalla scheda prodotto (snippets/tomassi-roast-line.liquid)
  e da ogni altro <roasting-countdown> della pagina, perché questo script è il primo
  a definire il custom element.
  I testi arrivano come parametri (italiani) dal render in header.liquid; qui
  vengono tradotti in EN via mappa quando request.locale.iso_code == 'en'.
{%- endcomment -%}

{%- assign rb = uid | default: 'rb' -%}
{%- assign L = request.locale.iso_code -%}
{%- assign _label = label -%}{%- assign _text = text -%}{%- assign _btn = button_label -%}
{%- assign _ship = shipping_note | default: 'Spedizione gratuita da €69' -%}
{%- if L == 'en' -%}
  {%- case label -%}
    {%- when 'Prossima tostatura' -%}{%- assign _label = 'Next roast' -%}
  {%- endcase -%}
  {%- case text -%}
    {%- when 'Tostiamo su ordinazione, ogni martedì.' -%}{%- assign _text = 'We roast to order, every Tuesday.' -%}
    {%- when 'Anche i lotti rari si tostano di martedì.' -%}{%- assign _text = 'Even the rarest lots are roasted on Tuesdays.' -%}
  {%- endcase -%}
  {%- case button_label -%}
    {%- when 'Scegli il tuo caffè' -%}{%- assign _btn = 'Choose your coffee' -%}
    {%- when 'Scegli quale limite oltrepassare' -%}{%- assign _btn = 'Choose which limit to break' -%}
  {%- endcase -%}
  {%- if _ship == 'Spedizione gratuita da €69' -%}{%- assign _ship = 'Free shipping from €69' -%}{%- endif -%}
{%- endif -%}

<div class="roast-bar roast-bar--{{ rb }}" style="--rb-bg: {{ bg_color | default: '#0F4A27' }}; --rb-fg: {{ fg_color | default: '#F6EEDC' }}; --rb-accent: {{ accent_color | default: '#C2922D' }};">
  <roasting-countdown class="roast-bar__inner page-width" data-roast-day="2" data-roast-hour="12" data-lang="{{ L }}">
    <div class="roast-bar__state" data-roast-counting>
      {%- if _label != blank -%}<span class="roast-bar__kicker"><span class="roast-bar__pulse" aria-hidden="true"></span>{{ _label | escape }}</span>{%- endif -%}
      <span class="roast-bar__clock" role="timer" aria-hidden="true">
        <b data-roast-days>--</b><i>{% if L == 'en' %}d{% else %}g{% endif %}</i>
        <b data-roast-hours>--</b><i>h</i>
        <b data-roast-minutes>--</b><i>m</i>
        {%- if show_seconds -%}<b data-roast-seconds>--</b><i>s</i>{%- endif -%}
      </span>
      {%- if _text != blank -%}<span class="roast-bar__text">{{ _text | escape }}</span>{%- endif -%}
      {%- if _ship != blank -%}<span class="roast-bar__ship">{{ _ship | escape }}</span>{%- endif -%}
      {%- if _btn != blank and button_link != blank -%}
        <a class="roast-bar__btn" href="{{ button_link }}">{{ _btn | escape }}</a>
      {%- endif -%}
      <span class="visually-hidden" data-roast-sr aria-live="off"></span>
    </div>
    <span data-roast-today hidden></span>
  </roasting-countdown>
</div>

{%- style -%}
  .roast-bar {
    background: var(--rb-bg);
    color: var(--rb-fg);
    width: 100%;
  }
  .roast-bar__inner { padding-top: 0.7rem; padding-bottom: 0.7rem; }
  .header-wrapper:has(.header__inline-menu details[open]) .roast-bar--std .roast-bar__inner {
    opacity: 0;
    visibility: hidden;
  }
  .roast-bar__state {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem 1.6rem;
    font-size: 1.3rem;
    line-height: 1.3;
    text-align: center;
  }
  .roast-bar__state[hidden] { display: none; }
  .roast-bar__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #E6C268;
  }
  .roast-bar__pulse {
    width: 0.6rem; height: 0.6rem;
    border-radius: 50%;
    background: #E6C268;
    animation: roast-bar-ping 2.4s ease-out infinite;
  }
  @keyframes roast-bar-ping {
    0% { box-shadow: 0 0 0 0 rgba(230, 194, 104, 0.55); }
    70% { box-shadow: 0 0 0 6px rgba(230, 194, 104, 0); }
    100% { box-shadow: 0 0 0 0 rgba(230, 194, 104, 0); }
  }
  .roast-bar__clock {
    display: inline-flex;
    align-items: baseline;
    gap: 0.1rem;
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }
  .roast-bar__clock b { font-size: 1.5rem; font-weight: 700; color: var(--rb-accent); min-width: 1.6ch; text-align: right; }
  .roast-bar__clock i { font-style: normal; opacity: 0.75; margin-right: 0.4rem; }
  .roast-bar__clock i:last-child { margin-right: 0; }
  .roast-bar__text { opacity: 0.85; }
  .roast-bar__ship { font-weight: 600; }
  .roast-bar__btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.8rem;
    padding: 0.3rem 1.4rem;
    border-radius: 999px;
    background: var(--rb-accent);
    color: var(--rb-bg);
    font-size: 1.2rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .roast-bar__btn:hover { opacity: 0.9; }
  .roast-bar__btn:focus-visible { outline: 2px solid var(--rb-fg); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) {
    .roast-bar__pulse { animation: none; }
  }
  @media screen and (max-width: 989px) {
    .roast-bar__text, .roast-bar__btn { display: none; }
  }
  @media screen and (max-width: 749px) {
    .roast-bar__inner { padding-top: 0.5rem; padding-bottom: 0.5rem; }
    .roast-bar__state { font-size: 1.2rem; gap: 0.2rem 1rem; }
    .roast-bar__clock b { font-size: 1.3rem; }
  }
{%- endstyle -%}

{%- render 'roasting-countdown-script' -%}
