      when 'Tostiamo ad Aprilia'
        assign out = 'We roast in Aprilia'
      when 'dal'
        assign out = 'since'
      when 'Dalla tostatura alla spedizione'
        assign out = 'From roasting to shipping'
      # --- cta-band ×3 ---
      when 'Primo acquisto'
        assign out = 'First order'
      when 'Non sai da dove iniziare?'
        assign out = 'Not sure where to start?'
      when 'Parti da una selezione semplice. Un caffè facile, uno più fruttato, uno più spinto. Così capisci dove vuoi andare, senza ansia da scaffale specialty.'
        assign out = 'Start with a simple selection. One easy coffee, one fruitier, one bolder. That way you figure out where you want to go — no specialty-shelf anxiety.'
