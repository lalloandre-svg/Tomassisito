      when 'Nati ad Aprilia, cresciuti tra tostatura, gare e assaggi.'
        assign out = 'Born in Aprilia, raised on roasting, competitions and cupping.'
      when 'Tomassicoffee nasce nel 2013 dalla visione di Emanuele Tomassi. Oggi Andrè porta questa visione nella nuova generazione: gare, ricette, assaggio e divulgazione.'
        assign out = 'Tomassicoffee was born in 2013 from Emanuele Tomassi’s vision. Today Andrè carries it into a new generation: competitions, recipes, cupping and sharing what we know.'
      when 'Scopri la nostra storia'
        assign out = 'Discover our story'
      when 'Dal 2013, da Aprilia'
        assign out = 'Since 2013, from Aprilia'
      when 'Vuoi portare Tomassicoffee nel tuo locale?'
        assign out = 'Want to bring Tomassicoffee to your venue?'
      when 'Caffè, ricette, formazione, supporto e una torrefazione vera con cui parlare. Non vendiamo solo sacchi. Costruiamo un modo più serio e più semplice di servire caffè.'
        assign out = 'Coffee, recipes, training, support and a real roastery to talk to. We don’t just sell bags — we build a more serious, simpler way to serve coffee.'
      when 'Apri la sezione Business'
        assign out = 'Open the Business section'
      when 'Risposta entro 24h · Senza impegno'
        assign out = 'Reply within 24h · No commitment'
      # --- featured blog ---
      when 'Impara a bere meglio, senza complicarti la vita.'
        assign out = 'Learn to drink better, without complicating your life.'
      # --- OYL landing: oyl-hero + blocks ---
      when 'Lotti rari, profili fuori scala, caffè nati nel nostro mondo gara per spostare il limite del gusto.'
        assign out = 'Rare lots, off-the-charts profiles — coffees born in our competition world to push the limit of taste.'
      when 'Guarda la storia'
        assign out = 'Watch the story'
      when 'I caffè della serie'
        assign out = 'The coffees in the series'
      when 'Acquista'
        assign out = 'Buy'
      when 'Vedi tutti'
        assign out = 'View all'
      when 'Vedi tutta la serie'
        assign out = 'View the whole series'
      when 'Una grammatica sensoriale'
        assign out = 'A sensory grammar'
      when 'Imparare a leggere il gusto.'
        assign out = 'Learn to read taste.'
      when 'Impara a leggere il gusto.'
        assign out = 'Learn to read taste.'
      when 'Esplora la collezione'
        assign out = 'Explore the collection'
      when '<p>Ogni caffè della serie racconta un profilo preciso: frutta, fermentazione, dolcezza, acidità. Non li nascondiamo dietro parole difficili, li mettiamo in chiaro.</p><p>È la nostra grammatica sensoriale: un modo semplice per capire cosa stai per assaggiare e perché funziona.</p>'
        assign out = '<p>Every coffee in the series tells a precise profile: fruit, fermentation, sweetness, acidity. We don’t hide them behind difficult words — we lay them out clearly.</p><p>It’s our sensory grammar: a simple way to understand what you’re about to taste and why it works.</p>'
      when 'scegli.'
        assign out = 'choose.'
      when 'Da Aprilia, dal 2013. Emanuele e Andrè: due generazioni, una sola ossessione per il caffè fatto sul serio.'
        assign out = 'From Aprilia, since 2013. Emanuele and Andrè: two generations, one obsession for coffee done right.'
      when 'Ogni lotto è un limite da attraversare.'
        assign out = 'Every lot is a limit to cross.'
      when 'Esplora i caffè competition'
        assign out = 'Explore the competition coffees'
      # --- OYL collection / grammatica standalone ---
      when '<p>Lotti rari e profili estremi. Ogni caffè è un pezzo da collezione, scelto per spostare il limite.</p>'
        assign out = '<p>Rare lots and extreme profiles. Every coffee is a collector’s piece, chosen to push the limit.</p>'
      when 'Altri caffè della serie'
        assign out = 'More coffees in the series'
      # --- OYL cinema ---
      when 'The Competition Series'
        assign out = 'The Competition Series'
      when 'Guarda la storia.'
        assign out = 'Watch the story.'
      when "Dietro ogni lotto c'è una gara vera: assaggi, ricette, errori e medaglie. Questo è il mondo da cui nascono i caffè Over Your Limits."
        assign out = 'Behind every lot there’s a real competition: tastings, recipes, mistakes and medals. This is the world the Over Your Limits coffees come from.'
      when 'Guarda il film'
        assign out = 'Watch the film'
      when 'Lotti limitati'
        assign out = 'Limited lots'
      when 'Nato in gara'
        assign out = 'Born in competition'
      when 'Fuori scala'
        assign out = 'Off the charts'
      when 'Non per tutti'
        assign out = 'Not for everyone'
      when 'Pezzi da collezione'
        assign out = 'Collector’s lots'
      # --- OYL grammatica (standalone) ---
      when '<p>Ogni lotto racconta una nota dominante. Questi sono i gusti che cerchiamo nei nostri caffè fuori scala.</p>'
        assign out = '<p>Every lot tells one dominant note. These are the flavours we look for in our off-the-charts coffees.</p>'
      when 'Scopri la grammatica'
        assign out = 'Explore the grammar'
      when 'Scopri di più'
        assign out = 'Learn more'
      when 'Anguria'
        assign out = 'Watermelon'
      when 'Rosa'
        assign out = 'Rose'
      when 'Thè'
        assign out = 'Tea'
      when 'Limone'
        assign out = 'Lemon'
      when 'Mango'
        assign out = 'Mango'
      when 'Tè verde'
        assign out = 'Green tea'
      when 'Frutto della passione'
        assign out = 'Passion fruit'
      when 'Fresca, pulita, rara.'
        assign out = 'Fresh, clean, rare.'
      when 'Frutto maturo e miele d’acacia.'
        assign out = 'Ripe fruit and acacia honey.'
      when 'Petali freschi, profumo persistente.'
        assign out = 'Fresh petals, a lingering scent.'
      when 'Acidità vivace, anima tropicale.'
        assign out = 'Lively acidity, tropical soul.'
      when 'Erba dolce e fiori bianchi.'
        assign out = 'Sweet grass and white flowers.'
      when 'Acidità luminosa, pura energia.'
        assign out = 'Bright acidity, pure energy.'
      # --- PDP / blog / OYL collection / Business form (2026-09-24) ---
      when 'La storia nella tazza'
        assign out = 'The story in the cup'
      when 'Coltivato da tante mani,'
        assign out = 'Grown by many hands,'
      when 'tostato da una.'
        assign out = 'roasted by one.'
      when '<p>Selezione a mano, in altura. Noi lo tostiamo il martedì ad Aprilia, in piccoli lotti, con un profilo costruito al banco. Dalla pianta alla tua tazza, senza scorciatoie.</p>'
        assign out = '<p>Hand-picked, at altitude. We roast it on Tuesdays in Aprilia, in small batches, with a profile built at the cupping table. From plant to cup, no shortcuts.</p>'
      when 'Scopri come tostiamo'
        assign out = 'See how we roast'
      when 'Quello che c’è da sapere'
        assign out = 'What you need to know'
      when 'Aggiungi al carrello'
        assign out = 'Add to cart'
      when 'Rivendicalo'
        assign out = 'Claim it'
      when 'Il diario Tomassi'
        assign out = 'The Tomassi journal'
      when 'Dietro la'
        assign out = 'Behind the'
      when 'tazza.'
        assign out = 'cup.'
      when '<p>Origini, ricette, gare e piccole ossessioni quotidiane. Quello che impariamo davanti al tostino, raccontato come al banco: qualità seria, tono leggero.</p>'
        assign out = '<p>Origins, recipes, competitions and small daily obsessions. What we learn in front of the roaster, told the way we’d tell it at the bar: serious quality, light tone.</p>'
      when 'Aggiungi'
        assign out = 'Add'
      when 'Scegli'
        assign out = 'Choose'
      when 'Richiedi una consulenza'
        assign out = 'Book a consultation'
      when 'Raccontaci il tuo locale: ti aiutiamo a scegliere il caffè, le ricette e il metodo di lavoro giusto. Senza impegno.'
        assign out = 'Tell us about your venue: we’ll help you choose the coffee, the recipes and the right way of working. No commitment.'
      else
        assign out = s
    endcase
  endif
  if esc == false
    echo out
  else
    echo out | escape
  endif
-%}
