        assign out = 'Why Tomassi'
      when 'Numeri, non promesse.'
        assign out = 'Numbers, not promises.'
      when 'Campioni Italiani di Tostatura'
        assign out = 'Italian Roasting Champions'
      when 'Punteggio specialty in tazza'
